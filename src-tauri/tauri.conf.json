{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault-LM",
  "version": "0.1.0",
  "identifier": "com.vaultlm.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist",
    "beforeDevCommand": "npx vite web --port 5173 --strictPort",
    "beforeBuildCommand": "npx vite build web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vault-LM",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your notes, a study partner, all local",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/": "pdfium/"
    },
    "copyright": "© 2026 Vault-LM",
    "longDescription": "Vault-LM turns a folder of Markdown notes (an Obsidian vault works as-is) into a study partner: cited chat over your notes, flashcards with spaced repetition, quizzes, mind maps and more. Runs on your computer with local models, or with a cloud model you choose.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "espeak-ng"
        ]
      }
    }
  }
}
